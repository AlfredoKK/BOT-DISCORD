DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Google Drive agenda screenshot archive.
# Share the root Drive folder with the service account as Editor.
GOOGLE_DRIVE_ARCHIVE_ROOT_FOLDER_ID=your_drive_root_folder_id
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=service-account.json
# Alternative for hosted envs: paste the full service account JSON in one env var.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Supabase direct Postgres URLs. Keep real passwords only in .env.
SUPABASE_LICALL_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.zvfhhcxsdzyubufmexng.supabase.co:5432/postgres
SUPABASE_SECONDARY_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Rôles Discord autorisés à utiliser /rdvadmin, en plus de "admin" et "team lead" (défauts) et de la permission Administrateur.
# ADMIN_ROLE_IDS : IDs de rôle séparés par des virgules. ADMIN_ROLE_NAME : noms supplémentaires séparés par des virgules.
ADMIN_ROLE_IDS=
ADMIN_ROLE_NAME=admin

# Le bot enregistre ses commandes slash auprès de Discord à chaque démarrage.
# Mettre à false pour désactiver et utiliser `npm run deploy` manuellement.
REGISTER_COMMANDS_ON_START=true

# Dossier des données modifiables (agencies.json, google_token.json).
# En hébergement, pointer vers un volume persistant, ex: /data. Défaut: ./data
DATA_DIR=
# Alternative au fichier data/google_token.json : coller le JSON complet du token OAuth.
# Utilisé uniquement pour créer le fichier au premier démarrage.
GOOGLE_TOKEN_JSON=
# Fuseau horaire du serveur (obligatoire hors machine française)
TZ=Europe/Paris

# ── Alertes d'incident (e-mail + Discord) ──
# Quand quelque chose casse (commande, scheduler, Google, Discord), un rapport de bug
# complet part par e-mail via l'API Gmail du compte Google du bot, et dans un canal Discord.
# IMPORTANT : l'envoi d'e-mail nécessite la permission gmail.send. Après déploiement de
# cette version, relancer UNE fois /rdvadmin auth puis /rdvadmin callback avec le compte
# contact@licall.fr pour obtenir un token qui inclut ce scope (/rdvadmin alertes pour vérifier).
# Destinataire(s) des rapports, séparés par des virgules. Défaut: contact@licall.fr
ALERT_EMAIL_TO=contact@licall.fr
# Expéditeur (doit être le compte Google authentifié du bot). Défaut: contact@licall.fr
ALERT_EMAIL_FROM=contact@licall.fr
# ID du canal Discord où poster les incidents (embed + rapport .txt). Vide = pas d'envoi Discord.
ALERT_CHANNEL_ID=
# Délai minimum (minutes) entre deux envois du même incident. Défaut: 15
ALERT_COOLDOWN_MINUTES=15
# false = désactive les envois (le log console [ALERT] reste). Défaut: true
ALERTS_ENABLED=true

# ── Sonde de santé HTTP ──
# Port du serveur GET /health (fourni automatiquement par Railway). Défaut: 3000
PORT=3000
# URL publique du service (ex: https://mon-bot.up.railway.app), affichée par /rdvadmin alertes
PUBLIC_URL=
